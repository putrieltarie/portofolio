#Latihan 2
library(readxl)
Praktikum_3 <- read_excel("D:/OneDrive - UNISBA/Kuliah Semester 6/Prak AD3/nilai psikotes.xlsx",
sheet = "psikotes")
View(Praktikum_3)
x = Praktikum_3
head(x)
x1 = x[which(x$Gender=="Pria"), ] #X1 untuk kelompok gender pria (asal dari data X)
x2 = x[which(x$Gender=="Wanita"), ] #X2 untuk kelompok gender wanita (asal dari data X)
x1$Gender = NULL #Kolom kategori di NULL kan karena tidak dihitung
x2$Gender = NULL #Kolom kategori di NULL kan karena tidak dihitung
#Uji Normal Multivariat
# hipo kel 1 : data kel 1 berdistribusi norm multivariat
# hipo kel 2 : data kel 2 berdistribusi norm multivariat
install.packages("mvnTest")
library(mvnTest)
hasil1 =HZ.test(x1, qqplot = TRUE)
hasil1
hasil2 =HZ.test(x2, qqplot = TRUE)
hasil2
#Uji Kovarians
#H0 : matriks kovarians ke-i kelompok sama
#H1 : matriks kovarians ke-i kelompok berbeda
#krit uji : tolak H0 jika p-value < alfa
install.packages("biotools")
hasil1 =HZ.test(x1, qqplot = TRUE)
hasil1
hasil2 =HZ.test(x2, qqplot = TRUE)
hasil2
#Uji Kovarians
#H0 : matriks kovarians ke-i kelompok sama
#H1 : matriks kovarians ke-i kelompok berbeda
#krit uji : tolak H0 jika p-value < alfa
install.packages("biotools")
library(biotools)
#x ..
