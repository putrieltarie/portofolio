library(readxl)
data_latihan_p2 <- read_excel("D:/OneDrive - UNISBA/Kuliah Semester 6/Prak AD3/data latihan p2.xlsx",
sheet = "latihan 2.2")
x = data_latihan_p2
x1 = x[which(x$jenis=="consumer goods"), ]
x2 = x[which(x$jenis=="producer goods"), ]
#uji normalitas multivariat
library(mvnTest)
#nullkan yang ga dibutuhin (jenis, item)
x1$jenis = NULL
x2$jenis = NULL
x1$Item = NULL
x2$Item = NULL
hasil_consumergoods =HZ.test(x1, qqplot = TRUE)
hasil_consumergoods
#nullkan yang ga dibutuhin (jenis, item)
x1$jenis = NULL
x2$jenis = NULL
x1$Item = NULL
x2$Item = NULL
hasil_consumergoods =HZ.test(x1, qqplot = TRUE)
hasil_consumergoods =HZ.test(x1, qqplot = TRUE)
hasil_consumergoods
hasil_producergoods =HZ.test(x2, qqplot = TRUE)
hasil_producergoods
x1$jenis = NULL
x2$jenis = NULL
x1$Item = NULL
x2$Item = NULL
x1 = as.matrix(x1)
x2 = as.matrix(x2)
p = ncol(x1)
n1 = nrow(x1)
n2 = nrow(x2)
n = n1+n2
n
xbar1 = colMeans(x1)
xbar2 = colMeans(x2)
dbar = xbar2 - xbar1
v = ((n1-1)*var(x1)+(n2-1)*var(x2))/(n-2)
v
a = 0.05
t2 = (n1*n2*t(dbar)%*%solve(v)%*%dbar)/n
test = as.vector(((n-p-1)*t2)/((n-2)*p))
crit = qf(1-a, p, n-p-1)
pvalue = 1-pf(test,p, n-p-1)
result = list(test = test, critical = crit, p.value = pvalue, df1 = p, df2 = n-p-1)
result #hasil
#Uji kovarians
library(biotools)
y = x[, c(-1,-6)] #tempat dimana variabel pembeda kelompok disimpan
f = as.factor(x$jenis)
boxM(y,f)
hasil1 =HZ.test(x1, qqplot = TRUE)
hasil1
hasil2 =HZ.test(x2, qqplot = TRUE)
hasil2
hasil1 =HZ.test(x1, qqplot = TRUE)
hasil1
